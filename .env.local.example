# =============================================================================
# ЛОКАЛЬНАЯ РАЗРАБОТКА — скопируйте в .env:
#   scripts/local-setup.ps1   (Windows)
#   scripts/local-setup.sh    (Linux/macOS)
#
# Для VPS используйте .env.production.example — НЕ этот файл.
# =============================================================================

APP_NAME=YanParser
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
FRONTEND_URL=http://localhost:5173

DB_DATABASE=yanparser
DB_USERNAME=yanparser
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
MYSQL_PORT=3306

# Sanctum / CORS — только localhost (Vite :5173, API :8080)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

SEED_USER_NAME=Admin
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=password

# Внутри Docker-сети (не менять для локалки)
YANDEX_PARSER_URL=http://parser:8080
YANDEX_PARSER_TIMEOUT=300
PARSER_PORT=8081
